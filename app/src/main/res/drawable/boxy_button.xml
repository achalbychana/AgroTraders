<!-- boxy_button_background.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#DFFF00" />

    <!-- Border color and width -->
    <stroke
        android:width="2dp"
        android:color="#000000" />

    <!-- Corner radius -->
    <corners
        android:radius="0dp" /> <!-- Set radius to 0dp for sharp corners -->

</shape>
